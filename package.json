{
  "version": "1.1.32",
  "scripts": {
    "start:dev": "bun run --check --watch ./src/main.ts",
    "tests": "bun check && bun run lint",
    "retouch": "bun run prettier",
    "build": "bun run build:windows-x64 && bun run build:darwin-arm64 && bun run build:darwin-x64 && bun run build:linux-x64 && bun run build:linux-x64-musl && bun run build:linux-arm64 && bun run build:linux-arm64-musl",
    "build:windows-x64": "bun build --compile --minify --target bun-windows-x64 --outfile ./builds/stress-windows-x64 ./src/main.ts",
    "build:darwin-arm64": "bun build --compile --minify --target bun-darwin-arm64 --outfile ./builds/stress-darwin-arm64 ./src/main.ts",
    "build:darwin-x64": "bun build --compile --minify --target bun-darwin-x64 --outfile ./builds/stress-darwin-x64 ./src/main.ts",
    "build:linux-x64": "bun build --compile --minify --target bun-linux-x64 --outfile ./builds/stress-linux-x64 ./src/main.ts",
    "build:linux-x64-musl": "bun build --compile --minify --target bun-linux-x64-musl --outfile ./builds/stress-linux-x64-musl ./src/main.ts",
    "build:linux-arm64": "bun build --compile --minify --target bun-linux-arm64 --outfile ./builds/stress-linux-arm64 ./src/main.ts",
    "build:linux-arm64-musl": "bun build --compile --minify --target bun-linux-arm64-musl --outfile ./builds/stress-linux-arm64-musl ./src/main.ts",
    "lint": "eslint ./",
    "prettier": "prettier --write ./"
  },
  "dependencies": {
    "@keift/utils": "^1.0.12",
    "@types/bun": "^1.4.4",
    "@types/random-useragent": "^0.3.3",
    "dayjs": "^1.11.23",
    "prettier": "^3.9.10",
    "random-useragent": "^0.5.0",
    "rulint": "^1.1.18",
    "typof": "^1.1.4"
  }
}
